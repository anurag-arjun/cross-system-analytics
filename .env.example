# Nexus Analytics — Environment Variables
#
# Copy this file to .env and fill in your values.
# .env is gitignored by default.

# HyperSync API token (required for EVM ingestion)
# Get one free at https://app.envio.dev/api-tokens
HYPERSYNC_TOKEN=your_token_here

# CoinGecko API key (optional — DexScreener fallback works without it)
# Get one free at https://www.coingecko.com/en/api
# COINGECKO_API_KEY=your_key_here

# Optional: override default JSON-RPC endpoints
# BASE_RPC_URL=https://mainnet.base.org
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# Etherscan V2 unified API key (covers Ethereum, Base, Arbitrum, Optimism, Polygon
# with one key — chainid query param selects the chain). Used by the ABI fetcher.
# ETHERSCAN_API_KEY=your_key_here

# Dune API key for the protocol_contracts bootstrap export (registry + labels).
# Free tier: 2,500 credits/month, 20 credits/MB exported.
# DUNE_API_KEY=your_key_here

# Path to a local Dune Spellbook clone (https://github.com/duneanalytics/spellbook).
# Used by the spellbook seed importer.
# SPELLBOOK_PATH=/path/to/spellbook

# Postgres DSN for the protocol_contracts registry. If unset, the importer
# runs in-memory (dry-run) and only prints stats.
# PROTOCOL_CONTRACTS_DSN=postgresql://nexus:nexus@localhost:5434/nexus_ops

# ----- Prod (docker-compose.prod.yml on shieldtx-vps) -----
# Host-side overrides for cron + backfill that talk to the prod containers
# (which bind to non-default ports to avoid colliding with shieldtx-{ch,pg}).
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=18123
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=nexus
# CLICKHOUSE_DB=nexus
# PROTOCOL_CONTRACTS_DSN=postgresql://nexus:nexus@localhost:15434/nexus_ops
